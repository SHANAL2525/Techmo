---
import CraneRigSvg from "./CraneRigSvg.astro";
import ShippingContainer from "./ShippingContainer.astro";
---

<section
  id="crane-showcase"
  class="crane-showcase"
  aria-labelledby="crane-showcase-heading"
>
  <div class="crane-sticky-viewport">
    <div class="container crane-stage-wrapper">
      <!-- Calm Control & Progress Header -->
      <div class="crane-hud-bar">
        <div class="hud-left">
          <span class="hud-tag">Interactive Crane Showcase</span>
          <h2 id="crane-showcase-heading" class="h4 hud-title">
            Our Core Solutions, Delivered to Your Site
          </h2>
        </div>

        <div class="hud-telemetry" aria-live="polite" aria-atomic="true">
          <span class="hud-phase" id="crane-phase-readout">
            Scroll gently to lift and open the TECHMO container
          </span>
          <div class="hud-progress-track" aria-hidden="true">
            <div class="hud-progress-fill" id="crane-progress-fill"></div>
          </div>
        </div>

        <div class="hud-actions">
          <button
            type="button"
            id="crane-toggle-static-btn"
            class="hud-action-btn"
            aria-pressed="false"
          >
            Open Immediately
          </button>
          <a href="#steel-buildings" class="skip-crane-link">
            Skip Animation &darr;
          </a>
        </div>
      </div>

      <!-- Crane SVG Rig + Refined Shipping Container -->
      <div class="crane-assembly">
        <CraneRigSvg />
        <div class="container-lift-zone">
          <ShippingContainer />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initCraneScrollController } from "../../animations/craneScrollController";

  let controller = initCraneScrollController();

  window.addEventListener("pagehide", () => {
    if (controller) {
      controller.destroy();
      controller = null;
    }
  });
</script>

<style>
  .crane-showcase {
    position: relative;
    min-height: 210vh;
    background: linear-gradient(
      180deg,
      var(--surface-light-bg) 0%,
      var(--surface-white) 50%,
      var(--surface-warm-cream) 100%
    );
    border-bottom: 1px solid var(--border-subtle);
    padding-block: var(--space-lg);
  }

  .crane-sticky-viewport {
    position: sticky;
    top: 4.75rem;
    min-height: calc(100vh - 4.75rem);
    display: flex;
    align-items: center;
    padding-block: var(--space-md);
  }

  .crane-stage-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
  }

  .crane-hud-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background-color: var(--surface-white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .hud-left {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hud-tag {
    font-size: 0.75rem;
    color: var(--color-orange-active);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .hud-title {
    margin: 0;
    color: var(--color-navy-deep);
    font-size: var(--text-lg);
  }

  .hud-telemetry {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: min(100%, 18rem);
    flex: 1;
    max-width: 24rem;
  }

  .hud-phase {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-slate);
  }

  .hud-progress-track {
    width: 100%;
    height: 6px;
    background-color: var(--surface-light-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .hud-progress-fill {
    width: 100%;
    height: 100%;
    background-color: var(--color-orange-primary);
    transform-origin: left center;
    transform: scaleX(0.1);
    will-change: transform;
  }

  .hud-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .hud-action-btn {
    padding: 0.5rem 0.9rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    background-color: var(--surface-light-bg);
    color: var(--color-navy-deep);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  .hud-action-btn:hover {
    border-color: var(--color-orange-primary);
    color: var(--color-orange-active);
  }

  .skip-crane-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.9rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    background-color: var(--color-warm-cream, #FFF7ED);
    color: var(--color-orange-active);
    border: 1px solid var(--border-warm);
    text-decoration: none;
    border-radius: var(--radius-xs);
  }

  .skip-crane-link:hover {
    background-color: var(--color-orange-primary);
    color: var(--color-white);
  }

  .crane-assembly {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .container-lift-zone {
    width: 100%;
    margin-top: -0.9rem;
    z-index: var(--z-crane-hook);
  }

  @media (max-width: 47.99rem), (prefers-reduced-motion: reduce) {
    .crane-showcase {
      min-height: auto;
      padding-block: var(--space-xl);
    }

    .crane-sticky-viewport {
      position: static;
      min-height: auto;
    }

    .container-lift-zone {
      margin-top: 0;
    }
  }
</style>
