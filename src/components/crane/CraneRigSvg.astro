---
---

<div class="crane-rig-layer" aria-hidden="true">
  <svg
    viewBox="0 0 1120 220"
    preserveAspectRatio="xMidYMin meet"
    class="crane-rig-svg"
  >
    <!-- Refined Architectural Crane Mast (Left) -->
    <g id="crane-tower">
      <rect
        x="76"
        y="12"
        width="30"
        height="208"
        rx="4"
        fill="none"
        stroke="#334155"
        stroke-width="2.5"
      />
      <path
        d="M76 26 L106 54 L76 82 L106 110 L76 138 L106 166 L76 194 L106 218"
        fill="none"
        stroke="#94A3B8"
        stroke-width="1.8"
        stroke-linejoin="round"
      />
    </g>

    <!-- Elegant Horizontal Jib & Counterweight -->
    <g id="crane-jib">
      <!-- Counterweight Block -->
      <rect
        x="24"
        y="30"
        width="28"
        height="28"
        rx="4"
        fill="#0F172A"
      />
      <rect x="28" y="35" width="20" height="6" rx="2" fill="#F97316" />

      <!-- Top Apex & Suspension Cables -->
      <polygon
        points="76,38 91,8 106,38"
        fill="#FFFFFF"
        stroke="#0F172A"
        stroke-width="2.5"
        stroke-linejoin="round"
      />
      <line x1="91" y1="8" x2="36" y2="38" stroke="#64748B" stroke-width="1.8" />
      <line x1="91" y1="8" x2="460" y2="38" stroke="#64748B" stroke-width="1.8" />
      <line x1="91" y1="8" x2="880" y2="38" stroke="#94A3B8" stroke-width="1.5" />

      <!-- Main Horizontal Boom Bar -->
      <rect
        x="22"
        y="38"
        width="1040"
        height="18"
        rx="5"
        fill="#0F172A"
      />
      <rect
        x="26"
        y="43"
        width="1032"
        height="4"
        rx="2"
        fill="#F97316"
      />

      <!-- Clean Operator Cabin -->
      <rect
        x="106"
        y="56"
        width="28"
        height="24"
        rx="4"
        fill="#FFFFFF"
        stroke="#0F172A"
        stroke-width="2"
      />
      <rect x="112" y="61" width="16" height="11" rx="2" fill="#E0F2FE" />
    </g>

    <!-- Movable Trolley Assembly -->
    <g id="crane-trolley" class="crane-trolley-group">
      <!-- Trolley Carriage -->
      <rect
        x="512"
        y="52"
        width="96"
        height="14"
        rx="4"
        fill="#FFFFFF"
        stroke="#0F172A"
        stroke-width="2.5"
      />
      <circle cx="528" cy="52" r="4" fill="#F97316" />
      <circle cx="592" cy="52" r="4" fill="#F97316" />

      <!-- Hoist Cables -->
      <g id="crane-cables" class="crane-cables-group">
        <line x1="542" y1="66" x2="542" y2="132" stroke="#475569" stroke-width="2.5" />
        <line x1="578" y1="66" x2="578" y2="132" stroke="#475569" stroke-width="2.5" />
      </g>

      <!-- Hook & Spreader Bar Assembly -->
      <g id="crane-hook" class="crane-hook-group">
        <rect
          x="530"
          y="124"
          width="60"
          height="18"
          rx="5"
          fill="#F97316"
          stroke="#0F172A"
          stroke-width="2"
        />
        <!-- Hook Curve -->
        <path
          d="M556 142 L564 142 L564 153 C564 162 548 162 550 153"
          fill="none"
          stroke="#0F172A"
          stroke-width="3.5"
          stroke-linecap="round"
        />
        <!-- Slings to Container Top Corners -->
        <line x1="544" y1="142" x2="360" y2="178" stroke="#64748B" stroke-width="2" />
        <line x1="576" y1="142" x2="760" y2="178" stroke="#64748B" stroke-width="2" />
        <!-- Clean Spreader Beam -->
        <rect
          x="346"
          y="174"
          width="428"
          height="8"
          rx="4"
          fill="#0F172A"
        />
        <circle cx="358" cy="178" r="3" fill="#F97316" />
        <circle cx="762" cy="178" r="3" fill="#F97316" />
      </g>
    </g>
  </svg>
</div>

<style>
  .crane-rig-layer {
    width: 100%;
    max-width: 68rem;
    margin-inline: auto;
    pointer-events: none;
    user-select: none;
    z-index: var(--z-crane-rig);
  }

  .crane-rig-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .crane-trolley-group,
  .crane-cables-group,
  .crane-hook-group {
    will-change: transform;
  }

  .crane-cables-group {
    transform-origin: 560px 66px;
  }
</style>
