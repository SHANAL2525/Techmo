---
import { projectPlaceholders } from "../../data/projects";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section
  id="project-gallery"
  class="gallery-section"
  aria-labelledby="gallery-heading"
>
  <div class="container gallery-wrapper">
    <div class="gallery-header-row">
      <SectionHeading
        eyebrow="Concept & Structural Gallery"
        title="Engineered Building Systems & Concept Illustrations"
        description="Explore representative structural typologies across our industrial steel, roofing and residential A-Frame divisions. Final site photography will replace these illustrations once supplied."
        headingId="gallery-heading"
        accentTone="sky"
      />
      <div class="gallery-status-badge">
        <span>Illustration Placeholders — Photos Pending</span>
      </div>
    </div>

    <div class="gallery-grid">
      {
        projectPlaceholders.map((project) => {
          const bgFill =
            project.category === "Steel Buildings"
              ? "#FFF7ED"
              : project.category === "Roofing & Fabrication"
                ? "#E0F2FE"
                : "#D1FAE5";
          return (
            <article class="project-card">
              <div class="project-visual">
                <div class="visual-top-bar">
                  <span class="project-cat">{project.category}</span>
                  <span class="project-code">{project.code}</span>
                </div>

                <svg
                  viewBox="0 0 400 220"
                  role="img"
                  aria-label={`${project.title} architectural illustration placeholder`}
                  class="project-svg"
                >
                  <rect width="400" height="220" fill={bgFill} />
                  <line x1="28" y1="188" x2="372" y2="188" stroke="#334155" stroke-width="2.5" />

                  {project.diagramVariant === "warehouse-portal" && (
                    <g>
                      <path
                        d="M 65 188 L 65 95 L 200 50 L 335 95 L 335 188"
                        fill="#FFFFFF"
                        fill-opacity="0.88"
                        stroke="#0F172A"
                        stroke-width="4"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M 105 188 L 105 112 L 200 78 L 295 112 L 295 188"
                        fill="none"
                        stroke="#64748B"
                        stroke-width="2"
                      />
                      <rect
                        x="155"
                        y="128"
                        width="90"
                        height="60"
                        rx="3"
                        fill="#FFF7ED"
                        stroke="#F97316"
                        stroke-width="3"
                      />
                    </g>
                  )}

                  {project.diagramVariant === "multi-bay-factory" && (
                    <g>
                      <path
                        d="M 45 188 L 45 100 L 148 64 L 250 100 L 250 188"
                        fill="#FFFFFF"
                        fill-opacity="0.88"
                        stroke="#0F172A"
                        stroke-width="4"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M 250 188 L 250 112 L 315 88 L 360 112 L 360 188"
                        fill="#FFFFFF"
                        fill-opacity="0.7"
                        stroke="#334155"
                        stroke-width="3"
                        stroke-linejoin="round"
                      />
                      <line
                        x1="45"
                        y1="144"
                        x2="250"
                        y2="144"
                        stroke="#F97316"
                        stroke-width="3.5"
                      />
                    </g>
                  )}

                  {project.diagramVariant === "standing-seam-roof" && (
                    <g>
                      <polygon
                        points="45,145 200,62 355,145"
                        fill="#FFFFFF"
                        fill-opacity="0.9"
                        stroke="#0F172A"
                        stroke-width="4"
                        stroke-linejoin="round"
                      />
                      <line x1="200" y1="62" x2="200" y2="145" stroke="#334155" stroke-width="2.5" />
                      <line x1="122" y1="104" x2="122" y2="145" stroke="#64748B" stroke-width="2" />
                      <line x1="278" y1="104" x2="278" y2="145" stroke="#64748B" stroke-width="2" />
                      <line x1="122" y1="145" x2="200" y2="62" stroke="#F97316" stroke-width="2.5" />
                      <line x1="278" y1="145" x2="200" y2="62" stroke="#F97316" stroke-width="2.5" />
                    </g>
                  )}

                  {project.diagramVariant === "cantilever-canopy" && (
                    <g>
                      <rect x="85" y="65" width="14" height="123" rx="3" fill="#0F172A" />
                      <polygon
                        points="99,85 335,70 335,84 99,115"
                        fill="#FFFFFF"
                        stroke="#F97316"
                        stroke-width="3.5"
                        stroke-linejoin="round"
                      />
                      <line x1="99" y1="65" x2="235" y2="76" stroke="#334155" stroke-width="2.5" />
                    </g>
                  )}

                  {project.diagramVariant === "aframe-chalet" && (
                    <g>
                      <polygon
                        points="95,188 200,36 305,188"
                        fill="#FFFFFF"
                        fill-opacity="0.92"
                        stroke="#0F172A"
                        stroke-width="4.5"
                        stroke-linejoin="round"
                      />
                      <line x1="138" y1="126" x2="262" y2="126" stroke="#F97316" stroke-width="3.5" />
                      <line x1="200" y1="36" x2="200" y2="188" stroke="#334155" stroke-width="2" />
                    </g>
                  )}

                  {project.diagramVariant === "steel-residence" && (
                    <g>
                      <rect
                        x="70"
                        y="125"
                        width="220"
                        height="63"
                        rx="3"
                        fill="#FFFFFF"
                        stroke="#334155"
                        stroke-width="3"
                      />
                      <rect
                        x="110"
                        y="68"
                        width="235"
                        height="57"
                        rx="3"
                        fill="#FFFFFF"
                        stroke="#0F172A"
                        stroke-width="4"
                      />
                      <line x1="55" y1="68" x2="360" y2="68" stroke="#F97316" stroke-width="4" stroke-linecap="round" />
                    </g>
                  )}
                </svg>

                <div class="placeholder-ribbon">
                  <span>Prototype Illustration — Site Photo Pending</span>
                </div>
              </div>

              <div class="project-body">
                <p class="project-spec">{project.structuralSystem.replace(" // ", " • ")}</p>
                <h3 class="h4 project-title">{project.title}</h3>
                <p class="text-small project-summary">{project.summary}</p>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .gallery-section {
    padding-block: var(--space-3xl);
    background-color: var(--surface-light-bg);
    border-bottom: 1px solid var(--border-subtle);
  }

  .gallery-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .gallery-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .gallery-status-badge {
    padding: 0.4rem 0.9rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-navy-deep);
    background-color: var(--surface-white);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-xs);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-lg);
  }

  .project-card {
    background-color: var(--surface-white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-orange-primary);
  }

  .project-visual {
    position: relative;
    background-color: var(--surface-white);
    border-bottom: 1px solid var(--border-subtle);
  }

  .visual-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) var(--space-md);
    background-color: var(--surface-white);
    border-bottom: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
  }

  .project-cat {
    color: var(--color-navy-deep);
    font-weight: var(--weight-bold);
  }

  .project-code {
    color: var(--color-slate-muted);
    font-size: 0.75rem;
  }

  .project-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .placeholder-ribbon {
    padding: 0.4rem var(--space-md);
    background-color: var(--surface-light-bg);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.75rem;
    color: var(--color-slate-muted);
    font-weight: var(--weight-medium);
  }

  .project-body {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex-grow: 1;
  }

  .project-spec {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-orange-active);
  }

  .project-title {
    margin: 0;
    color: var(--color-navy-deep);
  }

  .project-summary {
    margin: 0;
    color: var(--color-slate);
  }
</style>
