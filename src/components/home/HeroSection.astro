---
---

<section class="hero-section" aria-labelledby="hero-main-heading">
  <div class="container hero-layout">
    <div class="hero-content">
      <div class="hero-badge-row">
        <span class="badge-pill">Sri Lankan Engineering &amp; Construction</span>
      </div>

      <h1 id="hero-main-heading" class="text-display hero-heading">
        WE BUILD <span class="text-highlight">WHAT&apos;S NEXT.</span>
      </h1>

      <p class="text-lead hero-lead">
        From clear-span industrial steel buildings and weatherproof roofing to
        modern architectural A-Frame homes, TECHMO designs and builds lasting
        structures across Sri Lanka.
      </p>

      <div class="hero-cta-group">
        <a href="#crane-showcase" class="btn-primary">
          <span>Explore Our Solutions</span>
          <span aria-hidden="true">&darr;</span>
        </a>
        <a href="#project-gallery" class="btn-secondary">
          <span>View Concept Gallery</span>
        </a>
        <a href="#contact-cta" class="btn-ghost">
          <span>Talk to Our Team &rarr;</span>
        </a>
      </div>

      <dl class="hero-pillars" aria-label="Core engineering capabilities">
        <div class="pillar-item tone-warm">
          <dt class="pillar-tag">Steel Buildings</dt>
          <dd class="pillar-title">Warehouses, Factories &amp; Portal Frames</dd>
        </div>
        <div class="pillar-item tone-sky">
          <dt class="pillar-tag">Roofing &amp; Fabrication</dt>
          <dd class="pillar-title">Long-Span Trusses &amp; Metal Cladding</dd>
        </div>
        <div class="pillar-item tone-mint">
          <dt class="pillar-tag">Modern Living</dt>
          <dd class="pillar-title">A-Frame Cabanas &amp; Steel Homes</dd>
        </div>
      </dl>
    </div>

    <div class="hero-visual">
      <div class="illustration-card">
        <div class="illustration-top">
          <span class="illustration-title">Modern Steel &amp; Crane Engineering</span>
          <span class="illustration-pill">Scroll Experience Below</span>
        </div>

        <svg
          viewBox="0 0 480 380"
          role="img"
          aria-label="Clean architectural illustration of a TECHMO crane lifting a modular steel structure"
          class="hero-illustration-svg"
        >
          <defs>
            <linearGradient id="sky-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#E0F2FE" />
              <stop offset="100%" stop-color="#FFF7ED" />
            </linearGradient>
          </defs>
          <rect width="480" height="380" rx="12" fill="url(#sky-grad)" />

          <!-- Soft Sun Circle -->
          <circle cx="390" cy="82" r="44" fill="#FFEDD5" />

          <!-- Calm Horizon Ground -->
          <rect x="24" y="334" width="432" height="12" rx="6" fill="#CBD5E1" />
          <line x1="24" y1="334" x2="456" y2="334" stroke="#334155" stroke-width="2.5" />

          <!-- Refined Architectural Crane Tower (Left) -->
          <rect x="68" y="48" width="22" height="286" rx="3" fill="none" stroke="#334155" stroke-width="2.5" />
          <path
            d="M68 65 L90 95 L68 125 L90 155 L68 185 L90 215 L68 245 L90 275 L68 305 L90 334"
            fill="none"
            stroke="#64748B"
            stroke-width="1.8"
            stroke-linejoin="round"
          />

          <!-- Crane Horizontal Jib Boom -->
          <rect x="38" y="46" width="388" height="14" rx="4" fill="#0F172A" />
          <rect x="38" y="50" width="388" height="4" fill="#F97316" />

          <!-- Tower Apex & Stay Lines -->
          <polygon points="68,46 79,20 90,46" fill="#F97316" />
          <line x1="79" y1="20" x2="44" y2="46" stroke="#475569" stroke-width="1.8" />
          <line x1="79" y1="20" x2="310" y2="46" stroke="#475569" stroke-width="1.8" />

          <!-- Trolley & Hoist Cables -->
          <rect x="248" y="58" width="44" height="10" rx="3" fill="#0F172A" />
          <line x1="263" y1="68" x2="263" y2="132" stroke="#475569" stroke-width="2" />
          <line x1="277" y1="68" x2="277" y2="132" stroke="#475569" stroke-width="2" />

          <!-- Hook & Spreader Bar -->
          <rect x="252" y="132" width="36" height="10" rx="3" fill="#F97316" />
          <line x1="270" y1="142" x2="195" y2="172" stroke="#334155" stroke-width="2" />
          <line x1="270" y1="142" x2="345" y2="172" stroke="#334155" stroke-width="2" />

          <!-- Clean Suspended Container Module -->
          <rect
            x="170"
            y="172"
            width="200"
            height="86"
            rx="8"
            fill="#FFFFFF"
            stroke="#F97316"
            stroke-width="3"
          />
          <rect x="170" y="172" width="200" height="20" rx="6" fill="#F97316" />
          <text
            x="270"
            y="218"
            text-anchor="middle"
            fill="#0F172A"
            font-family="system-ui, sans-serif"
            font-weight="800"
            font-size="16"
          >
            TECHMO SOLUTIONS
          </text>
          <text
            x="270"
            y="238"
            text-anchor="middle"
            fill="#475569"
            font-family="system-ui, sans-serif"
            font-weight="500"
            font-size="11.5"
          >
            Scroll Down to Open Container
          </text>

          <!-- Lower Architectural Frame Silhouette -->
          <path
            d="M 142 334 L 142 292 L 270 274 L 398 292 L 398 334"
            fill="#FFFFFF"
            fill-opacity="0.65"
            stroke="#64748B"
            stroke-width="2"
            stroke-dasharray="6 4"
          />
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-block: var(--space-2xl) var(--space-3xl);
    background: linear-gradient(
      135deg,
      var(--surface-warm-cream) 0%,
      var(--surface-light-bg) 52%,
      var(--surface-soft-sky) 100%
    );
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero-badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }

  .badge-pill {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    background-color: var(--surface-white);
    color: var(--color-orange-active);
    border: 1px solid var(--border-warm);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-xs);
  }

  .hero-heading {
    margin: 0;
    color: var(--color-navy-deep);
  }

  .text-highlight {
    color: var(--color-orange-primary);
    display: inline-block;
  }

  .hero-lead {
    margin: 0;
    color: var(--color-slate);
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.9rem 1.5rem;
    background-color: var(--color-orange-primary);
    color: var(--color-white);
    font-weight: var(--weight-bold);
    text-decoration: none;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    transition: background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .btn-primary:hover {
    background-color: var(--color-orange-hover);
    color: var(--color-white);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.4rem;
    background-color: var(--surface-white);
    color: var(--color-navy-deep);
    border: 1px solid var(--border-strong);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-xs);
  }

  .btn-secondary:hover {
    border-color: var(--color-orange-primary);
    color: var(--color-orange-active);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 0.9rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-slate);
    text-decoration: none;
  }

  .btn-ghost:hover {
    color: var(--color-orange-primary);
  }

  .hero-pillars {
    margin: 0;
    padding-top: var(--space-sm);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-sm);
  }

  .pillar-item {
    padding: var(--space-md);
    border-radius: var(--radius-sm);
    background-color: var(--surface-white);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-xs);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pillar-item.tone-warm {
    background-color: var(--surface-warm-cream);
    border-color: var(--border-warm);
  }

  .pillar-item.tone-sky {
    background-color: var(--surface-soft-sky);
    border-color: var(--border-sky);
  }

  .pillar-item.tone-mint {
    background-color: var(--surface-soft-mint);
    border-color: var(--border-mint);
  }

  .pillar-tag {
    font-size: var(--text-xs);
    color: var(--color-navy-deep);
    font-weight: var(--weight-bold);
  }

  .pillar-title {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-slate);
  }

  .illustration-card {
    background-color: var(--surface-white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .illustration-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-inline: var(--space-xs);
    font-size: var(--text-xs);
  }

  .illustration-title {
    font-weight: var(--weight-bold);
    color: var(--color-navy-deep);
  }

  .illustration-pill {
    padding: 0.2rem 0.65rem;
    background-color: var(--surface-warm-cream);
    color: var(--color-orange-active);
    border-radius: var(--radius-pill);
    font-weight: var(--weight-semibold);
  }

  .hero-illustration-svg {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-sm);
  }

  @media (min-width: 62rem) {
    .hero-layout {
      grid-template-columns: 1.15fr 0.95fr;
    }
  }
</style>
