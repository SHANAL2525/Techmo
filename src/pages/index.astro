---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ConstructionJourney from "../components/home/ConstructionJourney.astro";

const title = "TECHMO | Engineering, Steel Buildings & Construction — Sri Lanka";
const description =
  "Scroll through construction with TECHMO: explore our interactive crane journey, industrial steel buildings, weatherproof roofing, custom fabrication and modern A-Frame structures in Sri Lanka.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content">
    <ConstructionJourney />
  </main>
  <Footer />
</BaseLayout>
